        "fnmonitor": {
            "display_name": "飞牛监控",
            "desc": "fnOS 系统监控面板：实时监控 CPU、内存、磁盘、网络、温度、功耗、GPU 与 Docker，支持历史趋势记录。",
            "platform": [
                "x86",
                "arm"
            ],
            "categories": [
                "系统工具"
            ],
            "icon_url": "./fnmonitor/ICON.PNG",
