                            "sha256": "95769c4efba26b40511598464b1d92300944eb062328665d4a84b64628b23a63",
                            "size": 759698
                        }
                    }
                },
                "2.42.15": {
                    "changelog": "v2.42.15 修复显卡/板卡添加按钮无输入框（issue #41）<br>① 后端 sanitize_power_gpus / sanitize_power_extras / sanitize_power_disks 遇到空 watt/空 name 直接丢弃整条，前端保存后重绘读不到新条目；现改为空字段保留占位，数值越界 clamp 而非丢弃",
